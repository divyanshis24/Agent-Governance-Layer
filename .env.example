# Aegis runs with none of these set. Copy to .env and edit to scale it up.

# --- storage ---------------------------------------------------------------
# Hot-path counters and kill flags. Unset = in-process store.
# REDIS_URL=redis://localhost:6379/0

# Policies, spend ledger and the audit chain. Unset = SQLite in backend/data/.
# DATABASE_URL=postgresql://aegis:aegis@localhost:5432/aegis

# --- policy engine ---------------------------------------------------------
# `rules` (in-house evaluator) or `opa` (Open Policy Agent sidecar).
POLICY_ENGINE=rules
# OPA_URL=http://localhost:8181
# OPA_DECISION_PATH=aegis/authz/decision

# --- fleet -----------------------------------------------------------------
FLEET_DAILY_CAP_CENTS=5000000

# FAIL_CLOSED=true          # require Redis/Postgres when configured — no silent fallback

# --- observability (docker compose) ----------------------------------------
# Prometheus → http://localhost:9090   Grafana → http://localhost:3000 (admin/aegis)
DEMO_MODE=true          # enables the audit tamper/restore endpoints
SEED_ON_START=true      # seed the six-agent demo fleet when none exists
RESET_ON_START=false    # wipe durable state on boot
AUDIT_ASYNC=true        # durable audit writes off the decision path

# --- server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
